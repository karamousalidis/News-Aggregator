# Required only for email delivery. Preview works without credentials.
RESEND_API_KEY=re_...
EMAIL_FROM=AI News Digest <digest@your-verified-domain.com>
DIGEST_RECIPIENTS=recipient@example.com

# Leave WATCHLIST empty for general AI news only.
WATCHLIST=NBIS,NVDA,AMD,PLTR
LOOKBACK_HOURS=24
MAX_ARTICLES=30
REQUEST_TIMEOUT=20
MAX_ATTEMPTS=3
